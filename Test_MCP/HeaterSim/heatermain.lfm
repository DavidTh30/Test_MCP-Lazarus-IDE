object FormHeater: TFormHeater
  Left = 200
  Height = 620
  Top = 100
  Width = 1120
  Caption = 'Heater Control Simulator'
  ClientHeight = 620
  ClientWidth = 1120
  Constraints.MinHeight = 500
  Constraints.MinWidth = 760
  Position = poScreenCenter
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  object sbLeft: TScrollBox
    Left = 0
    Height = 620
    Top = 0
    Width = 296
    HorzScrollBar.Page = 1
    HorzScrollBar.Visible = False
    VertScrollBar.Page = 1
    Align = alLeft
    BorderStyle = bsNone
    ClientHeight = 620
    ClientWidth = 296
    TabOrder = 0
    object gbRun: TGroupBox
      Left = 5
      Height = 92
      Top = 5
      Width = 286
      Align = alTop
      BorderSpacing.Around = 5
      Caption = ' Heater '
      ClientHeight = 72
      ClientWidth = 282
      TabOrder = 0
      object btnStart: TButton
        Left = 6
        Height = 30
        Top = 2
        Width = 132
        Caption = 'Start'
        Font.Height = -14
        Font.Style = [fsBold]
        OnClick = btnStartClick
        ParentFont = False
        TabOrder = 0
      end
      object btnStop: TButton
        Left = 144
        Height = 30
        Top = 2
        Width = 132
        Caption = 'Stop'
        Font.Height = -14
        Font.Style = [fsBold]
        OnClick = btnStopClick
        ParentFont = False
        TabOrder = 1
      end
      object lblSP: TLabel
        Left = 8
        Height = 15
        Top = 44
        Width = 80
        Caption = 'Setpoint (°C)'
      end
      object seSP: TFloatSpinEdit
        Left = 100
        Height = 23
        Top = 40
        Width = 90
        DecimalPlaces = 1
        Increment = 5
        MaxValue = 300
        TabOrder = 2
        Value = 120
      end
      object btnApplySP: TButton
        Left = 198
        Height = 25
        Top = 39
        Width = 78
        Caption = 'Apply'
        OnClick = btnApplySPClick
        TabOrder = 3
      end
    end
    object gbMode: TGroupBox
      Left = 5
      Height = 76
      Top = 102
      Width = 286
      Align = alTop
      BorderSpacing.Around = 5
      Caption = ' Mode '
      ClientHeight = 56
      ClientWidth = 282
      TabOrder = 1
      object rbAuto: TRadioButton
        Left = 8
        Height = 19
        Top = 2
        Width = 90
        Caption = 'Auto (PID)'
        Checked = True
        OnChange = rbModeChange
        TabOrder = 0
        TabStop = True
      end
      object rbManual: TRadioButton
        Left = 120
        Height = 19
        Top = 2
        Width = 70
        Caption = 'Manual'
        OnChange = rbModeChange
        TabOrder = 1
      end
      object lblManual: TLabel
        Left = 8
        Height = 15
        Top = 30
        Width = 110
        Caption = 'Manual output: 30 %'
      end
      object tbManual: TTrackBar
        Left = 130
        Height = 28
        Top = 24
        Width = 146
        Frequency = 10
        Max = 100
        OnChange = tbManualChange
        Position = 30
        TabOrder = 2
      end
    end
    object gbPID: TGroupBox
      Left = 5
      Height = 104
      Top = 183
      Width = 286
      Align = alTop
      BorderSpacing.Around = 5
      Caption = ' PID '
      ClientHeight = 84
      ClientWidth = 282
      TabOrder = 2
      object lblKp: TLabel
        Left = 8
        Height = 15
        Top = 6
        Width = 60
        Caption = 'Kp (gain)'
      end
      object seKp: TFloatSpinEdit
        Left = 92
        Height = 23
        Top = 2
        Width = 90
        DecimalPlaces = 2
        Increment = 0.1
        MaxValue = 100
        TabOrder = 0
        Value = 2
      end
      object lblKi: TLabel
        Left = 8
        Height = 15
        Top = 33
        Width = 60
        Caption = 'Ki (1/s)'
      end
      object seKi: TFloatSpinEdit
        Left = 92
        Height = 23
        Top = 29
        Width = 90
        DecimalPlaces = 3
        Increment = 0.005
        MaxValue = 10
        TabOrder = 1
        Value = 0.05
      end
      object lblKd: TLabel
        Left = 8
        Height = 15
        Top = 60
        Width = 60
        Caption = 'Kd (s)'
      end
      object seKd: TFloatSpinEdit
        Left = 92
        Height = 23
        Top = 56
        Width = 90
        DecimalPlaces = 2
        Increment = 0.5
        MaxValue = 200
        TabOrder = 2
        Value = 5
      end
      object btnApplyPID: TButton
        Left = 190
        Height = 50
        Top = 1
        Width = 86
        Caption = 'Apply PID'
        Font.Style = [fsBold]
        OnClick = btnApplyPIDClick
        ParentFont = False
        TabOrder = 3
      end
      object btnResetI: TButton
        Left = 190
        Height = 26
        Top = 55
        Width = 86
        Caption = 'Reset I'
        OnClick = btnResetIClick
        TabOrder = 4
      end
    end
    object gbPlant: TGroupBox
      Left = 5
      Height = 118
      Top = 292
      Width = 286
      Align = alTop
      BorderSpacing.Around = 5
      Caption = ' Scenario (mystery plant) '
      ClientHeight = 98
      ClientWidth = 282
      TabOrder = 3
      object lblScenario: TLabel
        Left = 8
        Height = 32
        Top = 2
        Width = 268
        AutoSize = False
        Caption = 'Scenario'
        Font.Style = [fsBold]
        ParentFont = False
        WordWrap = True
      end
      object btnNewScenario: TButton
        Left = 6
        Height = 28
        Top = 36
        Width = 270
        Caption = 'New random plant (keeps running)'
        Font.Style = [fsBold]
        OnClick = btnNewScenarioClick
        ParentFont = False
        TabOrder = 0
      end
      object chkReveal: TCheckBox
        Left = 8
        Height = 19
        Top = 72
        Width = 120
        Caption = 'Show plant'
        OnChange = chkRevealChange
        TabOrder = 1
      end
      object lblSpeed: TLabel
        Left = 140
        Height = 15
        Top = 74
        Width = 34
        Caption = 'Speed'
      end
      object cbSpeed: TComboBox
        Left = 184
        Height = 23
        Top = 70
        Width = 92
        ItemHeight = 15
        ItemIndex = 2
        Items.Strings = (
          'x1'
          'x2'
          'x5'
          'x10'
          'x30'
        )
        Style = csDropDownList
        TabOrder = 2
        Text = 'x5'
      end
    end
    object gbHistory: TGroupBox
      Left = 5
      Height = 56
      Top = 415
      Width = 286
      Align = alTop
      BorderSpacing.Around = 5
      Caption = ' History '
      ClientHeight = 36
      ClientWidth = 282
      TabOrder = 4
      object lblWindow: TLabel
        Left = 8
        Height = 15
        Top = 8
        Width = 40
        Caption = 'Window'
      end
      object cbWindow: TComboBox
        Left = 58
        Height = 23
        Top = 4
        Width = 74
        ItemHeight = 15
        ItemIndex = 1
        Items.Strings = (
          '1 min'
          '5 min'
          '10 min'
          '30 min'
          '60 min'
        )
        Style = csDropDownList
        TabOrder = 0
        Text = '5 min'
      end
      object btnClear: TButton
        Left = 140
        Height = 25
        Top = 3
        Width = 62
        Caption = 'Clear'
        OnClick = btnClearClick
        TabOrder = 1
      end
      object btnExport: TButton
        Left = 208
        Height = 25
        Top = 3
        Width = 68
        Caption = 'CSV...'
        OnClick = btnExportClick
        TabOrder = 2
      end
    end
  end
  object pnlRight: TPanel
    Left = 296
    Height = 620
    Top = 0
    Width = 824
    Align = alClient
    BevelOuter = bvNone
    TabOrder = 1
    OnResize = pnlRightResize
  end
  object tmrSim: TTimer
    Interval = 100
    OnTimer = tmrSimTimer
    Left = 1040
    Top = 20
  end
  object dlgSave: TSaveDialog
    DefaultExt = '.csv'
    Filter = 'CSV|*.csv|All files|*.*'
    Options = [ofOverwritePrompt, ofEnableSizing, ofViewDetail]
    Left = 1000
    Top = 20
  end
end
