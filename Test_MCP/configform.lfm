object FormConfig: TFormConfig
  Left = 400
  Height = 598
  Top = 160
  Width = 520
  BorderStyle = bsDialog
  Caption = 'MCP Config'
  ClientHeight = 598
  ClientWidth = 520
  Position = poOwnerFormCenter
  object gbServer: TGroupBox
    Left = 8
    Height = 150
    Top = 8
    Width = 504
    Caption = ' Server (this program) '
    ClientHeight = 130
    ClientWidth = 500
    TabOrder = 0
    object chkEnabled: TCheckBox
      Left = 12
      Height = 19
      Top = 4
      Width = 140
      Caption = 'Enable MCP server'
      TabOrder = 0
    end
    object lblAddress: TLabel
      Left = 12
      Height = 15
      Top = 38
      Width = 80
      Caption = 'Bind address'
    end
    object cbAddress: TComboBox
      Left = 130
      Height = 23
      Top = 34
      Width = 150
      ItemHeight = 15
      Items.Strings = (
        '127.0.0.1'
        '0.0.0.0'
      )
      OnChange = SettingChanged
      TabOrder = 1
      Text = '127.0.0.1'
    end
    object lblPort: TLabel
      Left = 300
      Height = 15
      Top = 38
      Width = 30
      Caption = 'Port'
    end
    object sePort: TSpinEdit
      Left = 350
      Height = 23
      Top = 34
      Width = 90
      MaxValue = 65535
      MinValue = 1
      OnChange = SettingChanged
      TabOrder = 2
      Value = 8765
    end
    object lblEndpoint: TLabel
      Left = 12
      Height = 15
      Top = 70
      Width = 80
      Caption = 'Endpoint path'
    end
    object edEndpoint: TEdit
      Left = 130
      Height = 23
      Top = 66
      Width = 150
      OnChange = SettingChanged
      TabOrder = 3
      Text = '/mcp'
    end
    object lblServerName: TLabel
      Left = 12
      Height = 15
      Top = 102
      Width = 80
      Caption = 'Server name'
    end
    object edServerName: TEdit
      Left = 130
      Height = 23
      Top = 98
      Width = 150
      TabOrder = 4
      Text = 'lazarus-form'
    end
  end
  object gbClient: TGroupBox
    Left = 8
    Height = 196
    Top = 164
    Width = 504
    Caption = ' Client (Claude Code) '
    ClientHeight = 176
    ClientWidth = 500
    TabOrder = 1
    object lblClientName: TLabel
      Left = 12
      Height = 15
      Top = 8
      Width = 110
      Caption = 'Name in .mcp.json'
    end
    object edClientName: TEdit
      Left = 130
      Height = 23
      Top = 4
      Width = 150
      OnChange = SettingChanged
      TabOrder = 0
      Text = 'lazarus-form'
    end
    object lblUrl: TLabel
      Left = 12
      Height = 15
      Top = 40
      Width = 30
      Caption = 'URL'
    end
    object edUrl: TEdit
      Left = 130
      Height = 23
      Top = 36
      Width = 356
      Color = clBtnFace
      ReadOnly = True
      TabOrder = 1
    end
    object lblCmd: TLabel
      Left = 12
      Height = 15
      Top = 72
      Width = 100
      Caption = 'Command'
    end
    object edCmd: TEdit
      Left = 130
      Height = 23
      Top = 68
      Width = 290
      Color = clBtnFace
      ReadOnly = True
      TabOrder = 2
    end
    object btnCopyCmd: TButton
      Left = 426
      Height = 25
      Top = 67
      Width = 60
      Caption = 'Copy'
      OnClick = btnCopyCmdClick
      TabOrder = 3
    end
    object btnWriteMcpJson: TButton
      Left = 130
      Height = 25
      Top = 102
      Width = 150
      Caption = 'Write .mcp.json...'
      OnClick = btnWriteMcpJsonClick
      TabOrder = 4
    end
    object btnTest: TButton
      Left = 290
      Height = 25
      Top = 102
      Width = 130
      Caption = 'Test connection'
      OnClick = btnTestClick
      TabOrder = 5
    end
    object lblTimeout: TLabel
      Left = 12
      Height = 15
      Top = 142
      Width = 100
      Caption = 'Test timeout (ms)'
    end
    object seTimeout: TSpinEdit
      Left = 130
      Height = 23
      Top = 138
      Width = 90
      Increment = 500
      MaxValue = 60000
      MinValue = 500
      TabOrder = 6
      Value = 3000
    end
  end
  object gbNode: TGroupBox
    Left = 8
    Height = 116
    Top = 366
    Width = 504
    Caption = ' Node / Topology '
    ClientHeight = 96
    ClientWidth = 500
    TabOrder = 5
    object lblNodeId: TLabel
      Left = 12
      Height = 15
      Top = 8
      Width = 50
      Caption = 'Node id'
    end
    object edNodeId: TEdit
      Left = 130
      Height = 23
      Top = 4
      Width = 120
      TabOrder = 0
      Text = 'server-1'
    end
    object lblNodeName: TLabel
      Left = 262
      Height = 15
      Top = 8
      Width = 40
      Caption = 'Name'
    end
    object edNodeName: TEdit
      Left = 310
      Height = 23
      Top = 4
      Width = 176
      TabOrder = 1
    end
    object lblPeers: TLabel
      Left = 12
      Height = 15
      Top = 40
      Width = 60
      Caption = 'Peers'
    end
    object edPeers: TEdit
      Left = 130
      Height = 23
      Top = 36
      Width = 356
      Hint = 'id@host:port separated by commas, e.g. server-2@127.0.0.1:8766'
      ParentShowHint = False
      ShowHint = True
      TabOrder = 2
    end
    object chkUplink: TCheckBox
      Left = 12
      Height = 19
      Top = 70
      Width = 110
      Caption = 'Uplink to'
      TabOrder = 3
    end
    object edUplink: TEdit
      Left = 130
      Height = 23
      Top = 68
      Width = 356
      Hint = 'This server connects to another server as a client: node id (e.g. server-2) or URL'
      ParentShowHint = False
      ShowHint = True
      TabOrder = 4
    end
  end
  object gbLog: TGroupBox
    Left = 8
    Height = 60
    Top = 488
    Width = 504
    Caption = ' Log '
    ClientHeight = 40
    ClientWidth = 500
    TabOrder = 2
    object chkLogToFile: TCheckBox
      Left = 12
      Height = 19
      Top = 8
      Width = 120
      Caption = 'Log to file'
      TabOrder = 0
    end
    object chkVerbose: TCheckBox
      Left = 140
      Height = 19
      Top = 8
      Width = 160
      Caption = 'Verbose (request/response)'
      TabOrder = 1
    end
    object lblMaxLines: TLabel
      Left = 320
      Height = 15
      Top = 10
      Width = 80
      Caption = 'Max lines'
    end
    object seMaxLines: TSpinEdit
      Left = 400
      Height = 23
      Top = 6
      Width = 86
      Increment = 100
      MaxValue = 100000
      MinValue = 50
      TabOrder = 2
      Value = 500
    end
  end
  object lblHint: TLabel
    Left = 8
    Height = 36
    Top = 556
    Width = 320
    AutoSize = False
    Caption = ''
    Font.Color = clGrayText
    ParentFont = False
    WordWrap = True
  end
  object btnOK: TButton
    Left = 344
    Height = 28
    Top = 560
    Width = 80
    Caption = 'OK'
    Default = True
    OnClick = btnOKClick
    TabOrder = 3
  end
  object btnCancel: TButton
    Left = 432
    Height = 28
    Top = 560
    Width = 80
    Cancel = True
    Caption = 'Cancel'
    ModalResult = 2
    TabOrder = 4
  end
  object dlgSelectDir: TSelectDirectoryDialog
    Title = 'Select the project folder where Claude Code will be opened'
    Left = 456
    Top = 8
  end
end
